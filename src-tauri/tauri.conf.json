{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConanForge Mod Manager",
  "version": "0.4.1",
  "identifier": "com.local.conanmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ConanForge Mod Manager",
        "visible": false,
        "width": 1280,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640
      },
      {
        "label": "splash",
        "title": "ConanForge — Starting",
        "url": "splash.html",
        "width": 580,
        "height": 600,
        "center": true,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
